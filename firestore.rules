rules_version = '2';
// Правила Firestore (облачные персонажи) — копия для справки; действующие правила вставляются в консоли Firebase
// (Firestore Database → Rules). Документ персонажа: users/{uid}/chars/{charId} =
// { json, updatedAt, deleted, hist: [{ at, json }], histAt, trash, deletedAt } — читать и писать может только владелец.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/chars/{charId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
